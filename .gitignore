# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/
.venv/
venv/

# Editors and tooling state
.vscode/
.idea/
.claude/

# Datasets: large, downloadable, and regenerable.
#   CIFAR-10      -> torchvision download
#   shakespeare   -> python bench/prepare_shakespeare_char.py
data/

# Checkpoints. Kept out deliberately: an un-ignored checkpoint directory once
# produced a 125 GB archive temp file on the cluster.
*.pt
*.ckpt
*.safetensors

# Profiler artifacts. Raw chrome traces and CUDA memory snapshots are the bulk of
# a run's bytes; bench/profile_stats.py reads the compact profiler_ops.csv that
# sits beside them, so the heavy files never need to be committed.
*.pickle
profiler_trace.json
profiler_trace.json.gz

# Archives and logs produced by the cluster runbooks.
*.tar.gz
*.zip
*.log

# Campaign output. Every run directory is reproducible from the script plus the
# manifest it writes, and a full campaign is thousands of files -- one v10 sweep
# alone left 81 untracked paths and ~2.9 MB. Leaving this un-ignored meant a
# reflexive `git add -A` would commit the entire results tree along with the code
# change it was meant to capture. Transfer results with the bundle stage instead.
results/

# Generated reporting output. The generators are tracked (bench/report_figures.py,
# bench/make_evidence.py); their output is not. A figure or a results table is a
# build artifact of a particular campaign -- reproducible from the run
# directories plus the script, and stale the moment either changes.
fig/
docs/RESULTS.md
acceptance.csv
costmodel_*.json

# Personal records, not repository artifacts.
MEETING_DELIVERY.md
internship-evidence-*.md
docs/QWEN_MEETING_NOTES.md
docs/QWEN_RESULTS.md
docs/QWEN_ENGINE_PLAN.md
docs/MEETING_SCRIPT.md
docs/LLM_MATH_MAP.md
docs/LEARNING_TODO.md
docs/YUFAN_MEETING.md
